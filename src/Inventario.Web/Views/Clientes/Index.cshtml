@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre o documento" /></div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Buscar</button></div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Documento</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nombre</td>
                <td>@p.Documento</td>
                <td>@p.Telefono</td>
                <td>@p.Email</td>
                <td>@if (p.Activo) { <span class="badge bg-success">Activo</span> } else { <span class="badge bg-secondary">Inactivo</span> }</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-dark">@(p.Activo ? "Desactivar" : "Activar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
