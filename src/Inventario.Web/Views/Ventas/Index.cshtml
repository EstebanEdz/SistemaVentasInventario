@model IEnumerable<Venta>
@{
    ViewData["Title"] = "Ventas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva venta</a>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>#</th><th>Fecha</th><th>Cliente</th><th class="text-end">Subtotal</th><th class="text-end">IVA</th><th class="text-end">Total</th><th>Vendedor</th><th>Factura</th></tr></thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Id</td>
                <td>@v.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(v.Cliente?.Nombre ?? "Cliente general")</td>
                <td class="text-end">@v.Subtotal.ToString("C")</td>
                <td class="text-end">@v.Impuesto.ToString("C")</td>
                <td class="text-end fw-bold">@v.Total.ToString("C")</td>
                <td>@v.Usuario</td>
                <td>
                    @if (v.Factura != null)
                    {
                        <a asp-controller="Facturas" asp-action="Details" asp-route-id="@v.Factura.Id">@v.Factura.Numero</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted py-4">Aún no hay ventas registradas.</td></tr>
        }
        </tbody>
    </table>
</div>
