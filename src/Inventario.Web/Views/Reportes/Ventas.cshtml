@model ReporteVentasVm
@{
    ViewData["Title"] = "Reporte de ventas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Reporte de ventas</h2>
    <a asp-action="ExportarVentas" asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")" class="btn btn-outline-success">Exportar CSV</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3"><label class="form-label small">Desde</label><input type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label small">Hasta</label><input type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Consultar</button></div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="small text-muted">Ventas realizadas</div><div class="fs-3 fw-bold">@Model.NumeroVentas</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="small text-muted">Total vendido (con IVA)</div><div class="fs-3 fw-bold">@Model.TotalVentas.ToString("C")</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="small text-muted">Ticket promedio</div><div class="fs-3 fw-bold">@Model.TicketPromedio.ToString("C")</div></div></div></div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Ventas por día</div>
    <div class="card-body"><canvas id="grafico" height="90"></canvas></div>
</div>

<div class="card">
    <div class="card-header fw-semibold">Productos más vendidos</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Producto</th><th class="text-end">Unidades</th><th class="text-end">Valor vendido (sin IVA)</th></tr></thead>
            <tbody>
            @foreach (var p in Model.TopProductos)
            {
                <tr><td>@p.Nombre</td><td class="text-end">@p.Cantidad</td><td class="text-end">@p.Total.ToString("C")</td></tr>
            }
            @if (!Model.TopProductos.Any())
            {
                <tr><td colspan="3" class="text-center text-muted py-3">Sin ventas en el período.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('grafico'), {
            type: 'bar',
            data: {
                labels: @Json.Serialize(Model.PorDia.Select(x => x.Dia)),
                datasets: [{
                    label: 'Ventas diarias',
                    data: @Json.Serialize(Model.PorDia.Select(x => x.Total)),
                    backgroundColor: '#0d6efd'
                }]
            },
            options: { responsive: true }
        });
    </script>
}
