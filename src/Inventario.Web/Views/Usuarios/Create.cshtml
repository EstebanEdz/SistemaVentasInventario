@model UsuarioCrearVm
@{
    ViewData["Title"] = "Nuevo usuario";
}
<h2>Nuevo usuario</h2>
<form asp-action="Create" method="post" class="mt-3" style="max-width: 600px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" asp-items="new SelectList(Roles.Todos)" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">Crear usuario</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
