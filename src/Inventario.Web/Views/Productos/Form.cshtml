@model Producto
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo producto" : "Editar producto";
}
<h2>@ViewData["Title"]</h2>
<form asp-action="@(esNuevo ? "Create" : "Edit")" method="post" class="mt-3" style="max-width: 800px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Codigo" class="form-label"></label>
            <input asp-for="Codigo" class="form-control" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" asp-items="(SelectList)ViewBag.ListaCategorias" class="form-select">
                <option value="0">-- Seleccione --</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ProveedorId" class="form-label"></label>
            <select asp-for="ProveedorId" asp-items="(SelectList)ViewBag.ListaProveedores" class="form-select">
                <option value="">(Sin proveedor)</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="PrecioCompra" class="form-label"></label>
            <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="PrecioCompra" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="PrecioVenta" class="form-label"></label>
            <input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="StockMinimo" class="form-label"></label>
            <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
            <span asp-validation-for="StockMinimo" class="text-danger"></span>
        </div>
    </div>
    @if (!esNuevo)
    {
        <p class="text-muted">Stock actual: <strong>@Model.StockActual</strong>. Solo cambia mediante compras, ventas o ajustes de stock.</p>
    }
    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
