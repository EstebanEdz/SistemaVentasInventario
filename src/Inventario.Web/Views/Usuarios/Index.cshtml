@model IEnumerable<UsuarioFila>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios y roles</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr><td>@u.Nombre</td><td>@u.Email</td><td><span class="badge bg-primary">@u.Roles</span></td></tr>
        }
        </tbody>
    </table>
</div>
<div class="card mt-4">
    <div class="card-header fw-semibold">Matriz de permisos</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 text-center">
            <thead><tr><th class="text-start">Módulo</th><th>Admin</th><th>Vendedor</th><th>Almacenista</th></tr></thead>
            <tbody>
                <tr><td class="text-start">Dashboard, consulta de productos y alertas</td><td>✔</td><td>✔</td><td>✔</td></tr>
                <tr><td class="text-start">Productos, categorías y proveedores (edición)</td><td>✔</td><td>—</td><td>✔</td></tr>
                <tr><td class="text-start">Compras, ajustes y movimientos</td><td>✔</td><td>—</td><td>✔</td></tr>
                <tr><td class="text-start">Clientes, ventas y facturas</td><td>✔</td><td>✔</td><td>—</td></tr>
                <tr><td class="text-start">Reportes y usuarios</td><td>✔</td><td>—</td><td>—</td></tr>
            </tbody>
        </table>
    </div>
</div>
