@model CompraCrearVm
@{
    ViewData["Title"] = "Nueva compra";
}
<h2>Nueva compra</h2>
<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row mb-3">
        <div class="col-md-5">
            <label asp-for="ProveedorId" class="form-label"></label>
            <select asp-for="ProveedorId" asp-items="Model.Proveedores" class="form-select">
                <option value="0">-- Seleccione --</option>
            </select>
        </div>
        <div class="col-md-7">
            <label asp-for="Observacion" class="form-label"></label>
            <input asp-for="Observacion" class="form-control" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Productos de la compra</div>
        <div class="card-body">
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small">Producto</label>
                    <select id="selProducto" class="form-select">
                        @foreach (var p in Model.Productos)
                        {
                            <option value="@p.Id">@p.Codigo - @p.Nombre (stock: @p.StockActual)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Cantidad</label>
                    <input id="txtCantidad" type="number" min="1" value="1" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Costo unitario</label>
                    <input id="txtPrecio" type="number" min="0" step="0.01" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="button" id="btnAgregar" class="btn btn-outline-primary w-100">Agregar</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Costo</th><th class="text-end">Subtotal</th><th></th></tr></thead>
                    <tbody id="lineasBody"></tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end" id="lineasTotal">0.00</th><th></th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Registrar compra</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <script src="~/js/lineas.js"></script>
    <script>
        initLineas({
            productos: @Json.Serialize(Model.Productos),
            iniciales: @Json.Serialize(Model.Lineas),
            esVenta: false
        });
    </script>
}
