@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole(Roles.Admin);
    var almacen = esAdmin || User.IsInRole(Roles.Almacenista);
    var ventas = esAdmin || User.IsInRole(Roles.Vendedor);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Inventario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark d-print-none">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Inventario</a>
            @if (autenticado)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a></li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Productos" asp-action="Index" asp-route-soloBajo="true">Alertas @await Component.InvokeAsync("StockBajoBadge")</a>
                        </li>
                        @if (almacen)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Compras" asp-action="Index">Compras</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Movimientos" asp-action="Index">Movimientos</a></li>
                        }
                        @if (ventas)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Ventas" asp-action="Index">Ventas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Facturas" asp-action="Index">Facturas</a></li>
                        }
                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Reportes</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Ventas">Ventas por período</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Inventario">Inventario valorizado</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                        }
                    </ul>
                    <span class="navbar-text me-3">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Ok"] is string mensajeOk)
        {
            <div class="alert alert-success alert-dismissible fade show d-print-none" role="alert">
                @mensajeOk
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string mensajeError)
        {
            <div class="alert alert-danger alert-dismissible fade show d-print-none" role="alert">
                @mensajeError
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3 d-print-none">
        Sistema de Inventario y Ventas · ASP.NET Core · EF Core · SQL Server
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
