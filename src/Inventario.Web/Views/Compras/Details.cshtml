@model Compra
@{
    ViewData["Title"] = "Compra #" + Model.Id;
}
<h2>Compra #@Model.Id</h2>
<p class="text-muted">
    @Model.Fecha.ToString("yyyy-MM-dd HH:mm") · Proveedor: <strong>@Model.Proveedor?.Nombre</strong> · Registrada por @Model.Usuario
</p>
@if (!string.IsNullOrWhiteSpace(Model.Observacion))
{
    <p><em>@Model.Observacion</em></p>
}
<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Costo unitario</th><th class="text-end">Subtotal</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto?.Codigo - @d.Producto?.Nombre</td>
                <td class="text-end">@d.Cantidad</td>
                <td class="text-end">@d.CostoUnitario.ToString("C")</td>
                <td class="text-end">@d.Subtotal.ToString("C")</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("C")</th></tr></tfoot>
    </table>
</div>
<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
