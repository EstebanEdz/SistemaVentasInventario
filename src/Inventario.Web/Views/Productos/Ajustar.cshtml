@model AjusteVm
@{
    ViewData["Title"] = "Ajustar stock";
}
<h2>Ajustar stock</h2>
<p class="text-muted">@Model.ProductoNombre · Stock actual: <strong>@Model.StockActual</strong></p>
<form asp-action="Ajustar" method="post" style="max-width: 500px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProductoId" />
    <input type="hidden" asp-for="ProductoNombre" />
    <input type="hidden" asp-for="StockActual" />
    <div class="mb-3">
        <label asp-for="NuevoStock" class="form-label"></label>
        <input asp-for="NuevoStock" type="number" min="0" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Motivo" class="form-label"></label>
        <input asp-for="Motivo" class="form-control" placeholder="Ej: conteo físico, merma, daño" />
    </div>
    <button type="submit" class="btn btn-primary">Aplicar ajuste</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
